{
  "name": "orbit",
  "productName": "Orbit",
  "version": "0.0.1",
  "private": true,
  "description": "A personal Arc-style browser for macOS",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cloud": "node scripts/cloud-test.mjs",
    "test:e2e:cloud": "electron-vite build && node scripts/cloud-test.mjs --e2e",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "prepare": "husky",
    "postinstall": "node scripts/dev-app-name.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource-variable/comfortaa": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "fractional-indexing": "4.0.0",
    "tldts": "7.4.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@eslint/js": "10.0.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "codemirror": "6.0.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "lucide-react": "1.66.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/view": "6.43.14",
    "@lezer/common": "1.5.3",
    "@lezer/lr": "1.4.11",
    "es-toolkit": "1.52.0",
    "vscode-languageserver-textdocument": "1.0.15",
    "@opentelemetry/api": "1.9.1",
    "linkifyjs": "4.3.3",
    "prosemirror-changeset": "2.4.4",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "@huggingface/jinja": "0.5.10"
  }
}
