+++ b/chrome/browser/resources/orbit_ntp/orbit_ntp.css
@@ -0,0 +1,280 @@
+/* Orbit new tab page. Palette from Orbit's "Quietly Alive" tokens. */
+:root {
+  --ink: #0f1b24;
+ --night: #0c1f26;
+ --mist: #e8eef1;
+ --sea-glass: #7cc4b5;
+  --focus: #6cb8d9;
+ --accent: #6fb3aa;
+  --glass: rgb(255 255 255 / 0.10);
+ --glass-border: rgb(255 255 255 / 0.18);
+  --text: #fff;
+ --muted: rgb(255 255 255 / 0.68);
+  --ease: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+* { box-sizing: border-box; }
+
+html,
+ body { height: 100%;
+ margin: 0; }
+
+body {
+  font-family: 'Comfortaa', -apple-system, 'SF Pro Text', system-ui, sans-serif;
+  color: var(--text);
+  background: var(--night) var(--orbit-wallpaper) center / cover no-repeat fixed;
+  -webkit-font-smoothing: antialiased;
+  overflow-y: auto;
+}
+
+body::before { content: '';
+ position: fixed;
+ inset: 0;
+ background: linear-gradient(rgb(12 31 38 / 0.10), rgb(12 31 38 / 0.35));
+ pointer-events: none; }
+
+#page { position: relative;
+ max-width: 1120px;
+ margin: 0 auto;
+ padding: 8vh 24px 130px; }
+
+.glass {
+  background: var(--glass);
+ border: 1px solid var(--glass-border);
+  -webkit-backdrop-filter: blur(24px) saturate(1.4);
+ backdrop-filter: blur(24px) saturate(1.4);
+  box-shadow: 0 8px 32px rgb(0 0 0 / 0.18);
+}
+
+.hero { text-align: center; }
+
+.clock { font-size: clamp(64px, 9vw, 104px);
+ font-weight: 500;
+ letter-spacing: -0.02em;
+ line-height: 1;
+ text-shadow: 0 2px 24px rgb(0 0 0 / 0.25); }
+
+.date { margin-top: 10px;
+ color: var(--muted);
+ font-size: 18px; }
+
+.greeting { margin: 36px 0 0;
+ font-size: clamp(28px, 4vw, 44px);
+ font-weight: 500;
+ text-shadow: 0 2px 20px rgb(0 0 0 / 0.3); }
+
+.greeting .name { border-bottom: 1px dashed transparent;
+ outline: none;
+ cursor: text; }
+
+.greeting .name:hover,
+ .greeting .name:focus { border-bottom-color: var(--muted); }
+
+.tagline { margin-top: 14px;
+ color: var(--muted);
+ font-size: 18px; }
+
+.search { display: flex;
+ align-items: center;
+ gap: 12px;
+ max-width: 760px;
+ margin: 36px auto 0;
+ padding: 0 20px;
+ height: 58px;
+ border-radius: 29px;
+ transition: box-shadow .24s var(--ease), background .24s var(--ease); }
+
+.search:focus-within { background: rgb(255 255 255 / 0.16);
+ box-shadow: 0 0 0 2px var(--focus), 0 8px 32px rgb(0 0 0 / 0.2); }
+
+.search .spark { width: 22px;
+ height: 22px;
+ color: var(--sea-glass);
+ flex: none; }
+
+.search input { flex: 1;
+ min-width: 0;
+ background: none;
+ border: 0;
+ outline: 0;
+ color: var(--text);
+ font: inherit;
+ font-size: 17px; }
+
+.search input::placeholder { color: var(--muted); }
+
+.widgets { display: grid;
+ grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+ gap: 16px;
+ margin-top: 56px; }
+
+.card { border-radius: 20px;
+ padding: 18px 20px;
+ min-height: 170px;
+ display: flex;
+ flex-direction: column;
+ gap: 10px; }
+
+.card h2 { margin: 0;
+ font-size: 14px;
+ font-weight: 600;
+ display: flex;
+ justify-content: space-between;
+ align-items: center; }
+
+.card .sub { color: var(--muted);
+ font-weight: 400;
+ font-size: 12px; }
+
+.row { display: flex;
+ align-items: center;
+ gap: 10px;
+ font-size: 14px; }
+
+.row .dot { width: 8px;
+ height: 8px;
+ border-radius: 50%;
+ flex: none; }
+
+.row .grow { flex: 1;
+ min-width: 0;
+ overflow: hidden;
+ text-overflow: ellipsis;
+ white-space: nowrap; }
+
+.bar { height: 3px;
+ border-radius: 2px;
+ background: rgb(255 255 255 / 0.18);
+ overflow: hidden; }
+
+.bar > i { display: block;
+ height: 100%;
+ background: var(--accent); }
+
+.btn { border: 0;
+ border-radius: 14px;
+ padding: 8px 14px;
+ font: inherit;
+ font-size: 13px;
+ color: #fff;
+ background: rgb(255 255 255 / 0.16);
+ cursor: pointer;
+ transition: background .14s var(--ease); }
+
+.btn:hover { background: rgb(255 255 255 / 0.26); }
+
+.btn.primary { background: #2f7bdc; }
+
+.btn.primary:hover { background: #3a87ea; }
+
+.field { width: 100%;
+ background: rgb(255 255 255 / 0.08);
+ border: 1px solid transparent;
+ border-radius: 10px;
+ padding: 8px 10px;
+ color: #fff;
+ font: inherit;
+ font-size: 14px;
+ outline: 0; }
+
+.field:focus { border-color: var(--focus); }
+
+.field::placeholder { color: var(--muted); }
+
+textarea.field { resize: none;
+ flex: 1;
+ min-height: 90px; }
+
+.timer { font-size: 44px;
+ font-weight: 600;
+ letter-spacing: -0.02em; }
+
+.palette { display: flex;
+ flex: 1;
+ border-radius: 12px;
+ overflow: hidden;
+ min-height: 100px; }
+
+.palette i { flex: 1;
+ cursor: pointer; }
+
+.task { cursor: pointer; }
+
+.check { width: 18px;
+ height: 18px;
+ border-radius: 6px;
+ border: 1.5px solid var(--muted);
+ flex: none;
+ display: grid;
+ place-items: center;
+ font-size: 12px;
+ line-height: 1; }
+
+.task.done .check { background: var(--accent);
+ border-color: var(--accent); }
+
+.task.done .grow { text-decoration: line-through;
+ color: var(--muted); }
+
+.x { margin-left: auto;
+ background: none;
+ border: 0;
+ color: var(--muted);
+ cursor: pointer;
+ font-size: 16px; }
+
+.quote { font-style: italic;
+ font-size: 20px;
+ line-height: 1.35;
+ flex: 1; }
+
+.quote-mark { font-size: 44px;
+ line-height: .6;
+ color: var(--text); }
+
+.dock { position: fixed;
+ left: 50%;
+ bottom: 22px;
+ transform: translateX(-50%);
+ display: flex;
+ align-items: center;
+ gap: 10px;
+ padding: 10px 12px;
+ border-radius: 26px; }
+
+.tile { width: 46px;
+ height: 46px;
+ border-radius: 14px;
+ display: grid;
+ place-items: center;
+ font-size: 20px;
+ font-weight: 700;
+ color: #fff;
+ text-decoration: none;
+ background: rgb(255 255 255 / 0.12);
+ transition: transform .19s var(--ease);
+ position: relative; }
+
+.tile:hover { transform: translateY(-4px) scale(1.06); }
+
+.tile .rm { display: none;
+ position: absolute;
+ top: -6px;
+ right: -6px;
+ width: 18px;
+ height: 18px;
+ border-radius: 9px;
+ background: #222c;
+ font-size: 12px;
+ line-height: 18px;
+ text-align: center;
+ border: 0;
+ color: #fff;
+ cursor: pointer; }
+
+.tile:hover .rm { display: block; }
+
+.dock .sep { width: 1px;
+ align-self: stretch;
+ background: var(--glass-border); }
+@media (prefers-color-scheme: light) { :root { --text: #fff; } }
