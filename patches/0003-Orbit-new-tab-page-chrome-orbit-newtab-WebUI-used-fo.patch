+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>New Tab</title>
+  <link rel="stylesheet" href="orbit_assets.css">
+  <link rel="stylesheet" href="orbit_ntp.css">
+</head>
+<body>
+  <main id="page">
+    <section class="hero">
+      <div id="clock" class="clock">--:--</div>
+      <div id="date" class="date"></div>
+      <h1 id="greeting" class="greeting"></h1>
+      <div id="tagline" class="tagline">Focus. Create. Build. Repeat.</div>
+      <form id="search" class="search glass" autocomplete="off">
+        <svg class="spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
+        <input id="q" type="text" placeholder="Search the web or enter a website..." aria-label="Search or enter address" autofocus>
+      </form>
+    </section>
+    <section id="widgets" class="widgets"></section>
+  </main>
+  <nav id="dock" class="dock glass" aria-label="Shortcuts"></nav>
+  <script type="module" src="orbit_ntp.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/orbit_ntp/orbit_ntp.ts b/chrome/browser/resources/orbit_ntp/orbit_ntp.ts
new file mode 100644
index 0000000000..4f98c4a6be
--- /dev/null
+++ b/chrome/browser/resources/orbit_ntp/orbit_ntp.ts
@@ -0,0 +1,193 @@
+// @ts-nocheck
+// Copyright 2026 Songraphix. Orbit new tab page.
+// Vanilla JS, no innerHTML (WebUI enforces Trusted Types). State lives in
+// localStorage; nothing here talks to Electron or to the network.
+'use strict';
+
+const $ = (id) => document.getElementById(id);
+function el(tag, props = {}, ...kids) {
+  const n = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (k === 'class') n.className = v;
+    else if (k === 'style') n.style.cssText = v;
+    else if (k.startsWith('on')) n.addEventListener(k.slice(2), v);
+    else n.setAttribute(k, v);
+  }
+  for (const k of kids) n.append(k);
+  return n;
+}
+function load(key, fallback) {
+  try { const v = localStorage.getItem('orbit.' + key); return v === null ? fallback : JSON.parse(v); } catch { return fallback; }
+}
+function save(key, value) {
+  try { localStorage.setItem('orbit.' + key, JSON.stringify(value)); } catch {}
+}
+
+// ---- Clock, date, greeting ----
+const greetingEl = $('greeting');
+const nameEl = el('span', { class: 'name', contenteditable: 'plaintext-only', spellcheck: 'false', 'data-ph': 'your name', title: 'Click to set your name' });
+nameEl.textContent = load('name', '');
+nameEl.addEventListener('input', () => save('name', nameEl.textContent.trim()));
+nameEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); nameEl.blur(); } });
+const greetText = el('span');
+const comma = el('span');
+greetingEl.append(greetText, comma, nameEl);
+function tick() {
+  const d = new Date();
+  $('clock').textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
+  $('date').textContent = d.toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' });
+  const h = d.getHours();
+  greetText.textContent = h < 12 ? 'Good Morning' : h < 18 ? 'Good Afternoon' : 'Good Evening';
+  comma.textContent = nameEl.textContent || document.activeElement === nameEl ? ', ' : '';
+}
+nameEl.addEventListener('input', tick);
+tick();
+setInterval(tick, 1000);
+
+// ---- Search / address ----
+function go(text) {
+  text = text.trim();
+  if (!text) return;
+  let url;
+  if (/^[a-z][a-z0-9+.-]*:\/\//i.test(text)) url = text;
+  else if (/^[^\s]+\.[a-z]{2,}(\/[^\s]*)?$/i.test(text) || /^localhost(:\d+)?(\/|$)/.test(text)) url = 'https://' + text;
+  else url = 'https://www.google.com/search?q=' + encodeURIComponent(text);
+  window.location.href = url;
+}
+$('search').addEventListener('submit', (e) => { e.preventDefault(); go($('q').value); });
+
+// ---- Widgets ----
+const widgets = $('widgets');
+function card(title, sub) {
+  const head = el('h2', {}, title);
+  if (sub) head.append(el('span', { class: 'sub' }, sub));
+  const c = el('div', { class: 'card glass' }, head);
+  widgets.append(c);
+  return { c, head };
+}
+
+// Projects
+{
+  const { c } = card('Projects');
+  const projects = load('projects', [{ name: 'My first project', done: 0, total: 5, color: '#8b5cf6' }]);
+  const list = el('div', { style: 'display:flex;flex-direction:column;gap:12px' });
+  const render = () => {
+    list.replaceChildren(...projects.map((p) => el('div', {},
+      el('div', { class: 'row' }, el('span', { class: 'dot', style: `background:${p.color}` }), el('span', { class: 'grow' }, p.name), el('span', { class: 'sub' }, `${p.done}/${p.total}`)),
+      el('div', { class: 'bar', style: 'margin-top:6px' }, el('i', { style: `width:${(100 * p.done) / p.total}%` })))));
+  };
+  const add = el('input', { class: 'field', placeholder: 'Add a project…' });
+  add.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && add.value.trim()) {
+      projects.push({ name: add.value.trim(), done: 0, total: 5, color: ['#8b5cf6', '#3b82f6', '#10b981', '#f59e0b'][projects.length % 4] });
+      add.value = ''; save('projects', projects); render();
+    }
+  });
+  c.append(list, add); render();
+}
+
+// Palette
+{
+  const { c, head } = card('Palette');
+  const bar = el('div', { class: 'palette' });
+  const gen = () => {
+    const base = Math.floor(Math.random() * 360);
+    return [0, 1, 2, 3, 4].map((i) => `hsl(${(base + i * 18) % 360} 70% ${55 - i * 4}%)`);
+  };
+  let cols = load('palette', null) || gen();
+  const render = () => {
+    bar.replaceChildren(...cols.map((col) => el('i', { style: `background:${col}`, title: 'Click to copy', onclick: () => navigator.clipboard?.writeText(col) })));
+  };
+  head.append(el('button', { class: 'x', title: 'Shuffle', onclick: () => { cols = gen(); save('palette', cols); render(); } }, '⤮'));
+  c.append(bar); render();
+}
+
+// Notes
+{
+  const { c } = card('Notes');
+  const ta = el('textarea', { class: 'field', placeholder: 'Jot something down…' });
+  ta.value = load('notes', '');
+  ta.addEventListener('input', () => save('notes', ta.value));
+  c.append(ta);
+}
+
+// Focus timer
+{
+  const { c } = card('Your Focus');
+  let secs = 25 * 60, timer = null;
+  const t = el('div', { class: 'timer' });
+  const status = el('div', { class: 'sub' }, 'Ready when you are');
+  const btn = el('button', { class: 'btn primary' }, '▶ Start Focus');
+  const fmt = () => { t.textContent = `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`; };
+  btn.addEventListener('click', () => {
+    if (timer) { clearInterval(timer); timer = null; secs = 25 * 60; fmt(); btn.textContent = '▶ Start Focus'; status.textContent = 'Ready when you are'; return; }
+    btn.textContent = '■ Stop'; status.textContent = 'Stay with it';
+    timer = setInterval(() => {
+      if (--secs <= 0) { clearInterval(timer); timer = null; secs = 25 * 60; btn.textContent = '▶ Start Focus'; status.textContent = 'Session complete'; }
+      fmt();
+    }, 1000);
+  });
+  fmt(); c.append(t, status, btn);
+}
+
+// Today (tasks)
+{
+  const { c, head } = card('Today');
+  const tasks = load('tasks', []);
+  const list = el('div', { style: 'display:flex;flex-direction:column;gap:8px;flex:1' });
+  const count = el('span', { class: 'sub' });
+  head.append(count);
+  const render = () => {
+    count.textContent = `${tasks.filter((x) => !x.done).length} remaining`;
+    list.replaceChildren(...tasks.map((x, i) => el('div', { class: 'row task' + (x.done ? ' done' : '') },
+      el('span', { class: 'check', onclick: () => { x.done = !x.done; save('tasks', tasks); render(); } }, x.done ? '✓' : ''),
+      el('span', { class: 'grow' }, x.text),
+      el('button', { class: 'x', title: 'Delete', onclick: () => { tasks.splice(i, 1); save('tasks', tasks); render(); } }, '×'))));
+  };
+  const add = el('input', { class: 'field', placeholder: 'Add a task for today' });
+  add.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && add.value.trim()) { tasks.push({ text: add.value.trim(), done: false }); add.value = ''; save('tasks', tasks); render(); }
+  });
+  c.append(list, add); render();
+}
+
+// Quote
+{
+  const { c, head } = card('');
+  const quotes = [
+    'Creativity is intelligence having fun.', 'Well begun is half done.', 'Make it work, make it right, make it fast.',
+    'Simplicity is the ultimate sophistication.', 'The best way out is always through.', 'Done is better than perfect.',
+  ];
+  const q = el('div', { class: 'quote' });
+  let i = Math.floor(Math.random() * quotes.length);
+  const render = () => { q.textContent = quotes[i]; };
+  head.append(el('span', { class: 'quote-mark' }, '❝'), el('button', { class: 'x', title: 'Another quote', onclick: () => { i = (i + 1) % quotes.length; render(); } }, '↻'));
+  c.append(q); render();
+}
+
+// ---- Dock (shortcuts) ----
+const dock = $('dock');
+const colors = ['#4285f4', '#ef4444', '#8b5cf6', '#10b981', '#f59e0b', '#ec4899'];
+const shortcuts = load('shortcuts', [
+  { title: 'Google', url: 'https://www.google.com' },
+  { title: 'YouTube', url: 'https://www.youtube.com' },
+  { title: 'GitHub', url: 'https://github.com' },
+]);
+function renderDock() {
+  const tiles = shortcuts.map((s, i) => {
+    const a = el('a', { class: 'tile', href: s.url, title: s.title, style: `background:${colors[i % colors.length]}` }, (s.title[0] || '?').toUpperCase());
+    a.append(el('button', { class: 'rm', title: 'Remove', onclick: (e) => { e.preventDefault(); e.stopPropagation(); shortcuts.splice(i, 1); save('shortcuts', shortcuts); renderDock(); } }, '×'));
+    return a;
+  });
+  const input = el('input', { class: 'field', placeholder: 'Add site…', style: 'width:130px;display:none' });
+  const plus = el('a', { class: 'tile', href: '#', title: 'Add shortcut', onclick: (e) => { e.preventDefault(); input.style.display = 'block'; input.focus(); } }, '+');
+  input.addEventListener('keydown', (e) => {
+    if (e.key === 'Escape') { input.style.display = 'none'; }
+    if (e.key === 'Enter' && input.value.trim()) {
+      let u = input.value.trim(); if (!/^[a-z]+:\/\//i.test(u)) u = 'https://' + u;
+      try { const host = new URL(u).hostname.replace(/^www\./, ''); shortcuts.push({ title: host, url: u }); save('shortcuts', shortcuts); renderDock(); } catch {}
+    }
+  });
+  dock.replaceChildren(...tiles, el('span', { class: 'sep' }), plus, input);
+}
+renderDock();
