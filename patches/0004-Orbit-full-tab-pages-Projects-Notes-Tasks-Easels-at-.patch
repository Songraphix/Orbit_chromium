diff --git a/chrome/browser/resources/orbit_ntp/pages.ts b/chrome/browser/resources/orbit_ntp/pages.ts
new file mode 100644
index 0000000000..fbdef101e2
--- /dev/null
+++ b/chrome/browser/resources/orbit_ntp/pages.ts
@@ -0,0 +1,205 @@
+// @ts-nocheck
+// Copyright 2026 Songraphix. Orbit full-tab pages: Projects, Notes, Tasks, Easels.
+// Shares localStorage with the new tab page (same origin). No innerHTML.
+'use strict';
+
+const $ = (id) => document.getElementById(id);
+function el(tag, props = {}, ...kids) {
+  const n = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (k === 'class') n.className = v;
+    else if (k === 'style') n.style.cssText = v;
+    else if (k.startsWith('on')) n.addEventListener(k.slice(2), v);
+    else n.setAttribute(k, v);
+  }
+  for (const k of kids) n.append(k);
+  return n;
+}
+function load(key, fallback) {
+  try { const v = localStorage.getItem('orbit.' + key); return v === null ? fallback : JSON.parse(v); } catch { return fallback; }
+}
+function save(key, value) {
+  try { localStorage.setItem('orbit.' + key, JSON.stringify(value)); } catch {}
+}
+const uid = () => Math.random().toString(36).slice(2, 10);
+const COLORS = ['#8b5cf6', '#3b82f6', '#10b981', '#f59e0b', '#ec4899', '#ef4444'];
+
+const SECTIONS = [
+  { id: 'projects', label: 'Projects', icon: '▤' },
+  { id: 'notes', label: 'Notes', icon: '✎' },
+  { id: 'tasks', label: 'Tasks', icon: '☑' },
+  { id: 'easels', label: 'Easels', icon: '✐' },
+];
+
+// ---- Data (shared with the new tab page) ----
+function getNotes() {
+  let notes = load('notelist', null);
+  if (!notes) {
+    const old = load('notes', '');
+    notes = old ? [{ id: uid(), title: 'Quick note', body: old, updated: Date.now() }] : [];
+    save('notelist', notes);
+  }
+  return notes;
+}
+function getProjects() {
+  const ps = load('projects', []);
+  for (const p of ps) { if (!p.id) p.id = uid(); if (!p.tasks) p.tasks = []; }
+  return ps;
+}
+
+// ---- Views ----
+function viewProjects(view) {
+  const projects = getProjects();
+  let selected = projects[0]?.id ?? null;
+  const left = el('div', { class: 'list' });
+  const right = el('div', { class: 'editor' });
+  const addP = el('input', { class: 'field', placeholder: 'New project…' });
+  const persist = () => save('projects', projects);
+  const render = () => {
+    left.replaceChildren(addP, ...projects.map((p) => {
+      const done = p.tasks.filter((t) => t.done).length;
+      return el('div', { class: 'item' + (p.id === selected ? ' on' : ''), onclick: () => { selected = p.id; render(); } },
+        el('div', { class: 'row' }, el('span', { class: 'dot', style: `background:${p.color}` }), el('span', { class: 't grow' }, p.name), el('span', { class: 'sub' }, `${done}/${p.tasks.length}`)),
+        el('div', { class: 'bar' }, el('i', { style: `width:${p.tasks.length ? (100 * done) / p.tasks.length : 0}%` })));
+    }));
+    const p = projects.find((x) => x.id === selected);
+    if (!p) { right.replaceChildren(el('div', { class: 'sub' }, 'Create a project to get started.')); return; }
+    const title = el('input', { class: 'field', value: p.name, style: 'font-size:18px;font-weight:600' });
+    title.addEventListener('input', () => { p.name = title.value; persist(); });
+    const addT = el('input', { class: 'field', placeholder: 'Add a task to this project…' });
+    addT.addEventListener('keydown', (e) => {
+      if (e.key === 'Enter' && addT.value.trim()) { p.tasks.push({ id: uid(), text: addT.value.trim(), done: false }); persist(); render(); }
+    });
+    right.replaceChildren(
+      title,
+      ...p.tasks.map((t, i) => el('div', { class: 'row' + (t.done ? ' done' : '') },
+        el('span', { class: 'check', onclick: () => { t.done = !t.done; persist(); render(); } }, t.done ? '✓' : ''),
+        el('span', { class: 'grow' }, t.text),
+        el('button', { class: 'x', title: 'Delete task', onclick: () => { p.tasks.splice(i, 1); persist(); render(); } }, '×'))),
+      addT,
+      el('button', { class: 'btn', style: 'align-self:flex-start;margin-top:12px', onclick: () => { projects.splice(projects.indexOf(p), 1); selected = projects[0]?.id ?? null; persist(); render(); } }, 'Delete project'));
+  };
+  addP.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && addP.value.trim()) {
+      const p = { id: uid(), name: addP.value.trim(), color: COLORS[projects.length % COLORS.length], tasks: [] };
+      projects.push(p); selected = p.id; persist(); render();
+    }
+  });
+  view.append(el('h2', {}, 'Projects'), el('div', { class: 'split' }, left, right));
+  render();
+}
+
+function viewNotes(view) {
+  const notes = getNotes();
+  let selected = notes[0]?.id ?? null;
+  let query = '';
+  const left = el('div', { class: 'list' });
+  const right = el('div', { class: 'editor' });
+  const search = el('input', { class: 'field', placeholder: 'Search notes' });
+  const persist = () => save('notelist', notes);
+  const renderList = () => {
+    const shown = notes.filter((n) => (n.title + ' ' + n.body).toLowerCase().includes(query)).sort((a, b) => b.updated - a.updated);
+    left.replaceChildren(el('div', { class: 'row' }, search, el('button', { class: 'btn primary', onclick: newNote }, '+')),
+      ...shown.map((n) => el('div', { class: 'item' + (n.id === selected ? ' on' : ''), onclick: () => { selected = n.id; renderList(); renderEditor(); } },
+        el('div', { class: 't' }, n.title || 'Untitled'), el('div', { class: 's' }, new Date(n.updated).toLocaleString()))));
+  };
+  const renderEditor = () => {
+    const n = notes.find((x) => x.id === selected);
+    if (!n) { right.replaceChildren(el('div', { class: 'sub' }, 'No note selected.')); return; }
+    const title = el('input', { class: 'field', value: n.title, placeholder: 'Title', style: 'font-size:18px;font-weight:600' });
+    const body = el('textarea', { class: 'field', placeholder: 'Start writing…' });
+    body.value = n.body;
+    const touch = () => { n.title = title.value; n.body = body.value; n.updated = Date.now(); persist(); renderList(); };
+    title.addEventListener('input', touch); body.addEventListener('input', touch);
+    right.replaceChildren(title, body, el('button', { class: 'btn', style: 'align-self:flex-start', onclick: () => { notes.splice(notes.indexOf(n), 1); selected = notes[0]?.id ?? null; persist(); renderList(); renderEditor(); } }, 'Delete note'));
+  };
+  function newNote() { const n = { id: uid(), title: '', body: '', updated: Date.now() }; notes.unshift(n); selected = n.id; persist(); renderList(); renderEditor(); }
+  search.addEventListener('input', () => { query = search.value.toLowerCase(); renderList(); });
+  view.append(el('h2', {}, 'Notes'), el('div', { class: 'split' }, left, right));
+  renderList(); renderEditor();
+}
+
+function viewTasks(view) {
+  const tasks = load('tasks', []);
+  const list = el('div', { style: 'display:flex;flex-direction:column;gap:10px' });
+  const sub = el('span', { class: 'sub' });
+  const persist = () => save('tasks', tasks);
+  const render = () => {
+    sub.textContent = `${tasks.filter((t) => !t.done).length} remaining`;
+    list.replaceChildren(...tasks.map((t, i) => el('div', { class: 'row' + (t.done ? ' done' : '') },
+      el('span', { class: 'check', onclick: () => { t.done = !t.done; persist(); render(); } }, t.done ? '✓' : ''),
+      el('span', { class: 'grow' }, t.text),
+      el('button', { class: 'x', title: 'Delete', onclick: () => { tasks.splice(i, 1); persist(); render(); } }, '×'))));
+  };
+  const add = el('input', { class: 'field', placeholder: 'Add a task for today' });
+  add.addEventListener('keydown', (e) => { if (e.key === 'Enter' && add.value.trim()) { tasks.push({ text: add.value.trim(), done: false }); add.value = ''; persist(); render(); } });
+  const clear = el('button', { class: 'btn', style: 'align-self:flex-start', onclick: () => { for (let i = tasks.length - 1; i >= 0; i--) if (tasks[i].done) tasks.splice(i, 1); persist(); render(); } }, 'Clear completed');
+  view.append(el('h2', {}, 'Tasks', sub), add, list, clear);
+  render();
+}
+
+function viewEasels(view) {
+  const easels = load('easels', []);
+  let selected = easels[0]?.id ?? null;
+  let color = '#0f1b24', size = 3;
+  const left = el('div', { class: 'list' });
+  const right = el('div', { class: 'editor' });
+  const persist = () => save('easels', easels);
+  const renderList = () => {
+    left.replaceChildren(el('button', { class: 'btn primary', onclick: () => { const e = { id: uid(), name: 'Easel ' + (easels.length + 1), strokes: [] }; easels.unshift(e); selected = e.id; persist(); renderList(); renderBoard(); } }, '+ New easel'),
+      ...easels.map((e) => el('div', { class: 'item' + (e.id === selected ? ' on' : ''), onclick: () => { selected = e.id; renderList(); renderBoard(); } }, el('div', { class: 't' }, e.name), el('div', { class: 's' }, `${e.strokes.length} strokes`))));
+  };
+  const renderBoard = () => {
+    const e = easels.find((x) => x.id === selected);
