diff --git a/chrome/browser/resources/orbit_ntp/pages.css b/chrome/browser/resources/orbit_ntp/pages.css
new file mode 100644
index 0000000000..a08723b7d6
--- /dev/null
+++ b/chrome/browser/resources/orbit_ntp/pages.css
@@ -0,0 +1,310 @@
+/* Orbit full-tab pages: Projects, Notes, Tasks, Easels. */
+:root {
+  --night: #0c1f26;
+  --focus: #6cb8d9;
+  --accent: #6fb3aa;
+  --glass: rgb(12 31 38 / 0.46);
+  --glass-border: rgb(255 255 255 / 0.16);
+  --text: #fff;
+  --muted: rgb(255 255 255 / 0.62);
+  --ease: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  height: 100%;
+  margin: 0;
+}
+
+body {
+  font-family: Comfortaa, -apple-system, system-ui, sans-serif;
+  color: var(--text);
+  background: var(--night) var(--orbit-wallpaper) center / cover no-repeat fixed;
+  -webkit-font-smoothing: antialiased;
+}
+
+body::before {
+  content: '';
+  position: fixed;
+  inset: 0;
+  background: rgb(12 31 38 / 0.45);
+  pointer-events: none;
+}
+
+#app {
+  position: relative;
+  display: flex;
+  gap: 14px;
+  height: 100%;
+  padding: 14px;
+}
+
+.glass {
+  background: var(--glass);
+  border: 1px solid var(--glass-border);
+  -webkit-backdrop-filter: blur(28px) saturate(1.4);
+  backdrop-filter: blur(28px) saturate(1.4);
+  border-radius: 18px;
+}
+
+#nav {
+  width: 210px;
+  flex: none;
+  padding: 14px 10px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+#nav h1 {
+  font-size: 15px;
+  margin: 4px 10px 12px;
+}
+
+#nav a {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 12px;
+  border-radius: 12px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 14px;
+  transition: background 0.14s var(--ease);
+}
+
+#nav a:hover {
+  background: rgb(255 255 255 / 0.08);
+}
+
+#nav a.on {
+  background: rgb(255 255 255 / 0.18);
+}
+
+#view {
+  flex: 1;
+  min-width: 0;
+  padding: 22px 26px;
+  overflow: auto;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+
+h2 {
+  margin: 0;
+  font-size: 22px;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.sub {
+  color: var(--muted);
+  font-size: 12px;
+  font-weight: 400;
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 14px;
+}
+
+.grow {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.btn {
+  border: 0;
+  border-radius: 12px;
+  padding: 8px 14px;
+  font: inherit;
+  font-size: 13px;
+  color: #fff;
+  background: rgb(255 255 255 / 0.16);
+  cursor: pointer;
+}
+
+.btn:hover {
+  background: rgb(255 255 255 / 0.26);
+}
+
+.btn.primary {
+  background: #2f7bdc;
+}
+
+.field {
+  width: 100%;
+  background: rgb(255 255 255 / 0.09);
+  border: 1px solid transparent;
+  border-radius: 10px;
+  padding: 9px 12px;
+  color: #fff;
+  font: inherit;
+  font-size: 14px;
+  outline: 0;
+}
+
+.field:focus {
+  border-color: var(--focus);
+}
+
+.field::placeholder {
+  color: var(--muted);
+}
+
+.x {
+  background: none;
+  border: 0;
+  color: var(--muted);
+  cursor: pointer;
+  font-size: 18px;
+}
+
+.x:hover {
+  color: #fff;
+}
+
+.split {
+  display: flex;
+  gap: 16px;
+  flex: 1;
+  min-height: 0;
+}
+
+.list {
+  width: 260px;
+  flex: none;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  overflow: auto;
+}
+
+.item {
+  padding: 10px 12px;
+  border-radius: 12px;
+  cursor: pointer;
+  background: rgb(255 255 255 / 0.06);
+}
+
+.item:hover {
+  background: rgb(255 255 255 / 0.12);
+}
+
+.item.on {
+  background: rgb(255 255 255 / 0.2);
+}
+
+.item .t {
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.item .s {
+  color: var(--muted);
+  font-size: 12px;
+  margin-top: 2px;
+}
+
+.editor {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.editor textarea {
+  flex: 1;
+  resize: none;
+  line-height: 1.5;
+}
+
+.check {
+  width: 18px;
+  height: 18px;
+  border-radius: 6px;
+  border: 1.5px solid var(--muted);
+  flex: none;
+  display: grid;
+  place-items: center;
+  font-size: 12px;
+  cursor: pointer;
+}
+
+.done .check {
+  background: var(--accent);
+  border-color: var(--accent);
+}
+
+.done .grow {
+  text-decoration: line-through;
+  color: var(--muted);
+}
+
+.dot {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  flex: none;
+}
+
+.bar {
+  height: 4px;
+  border-radius: 2px;
+  background: rgb(255 255 255 / 0.18);
+  overflow: hidden;
+  margin-top: 6px;
+}
+
+.bar > i {
+  display: block;
+  height: 100%;
+  background: var(--accent);
+}
+
+.easel-wrap {
+  flex: 1;
+  min-height: 0;
+  border-radius: 14px;
+  overflow: hidden;
+  background: rgb(255 255 255 / 0.92);
+  position: relative;
+}
+
+canvas {
+  width: 100%;
+  height: 100%;
+  display: block;
+  cursor: crosshair;
+  touch-action: none;
+}
+
+.tools {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+}
+
+.sw {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  border: 2px solid transparent;
+  cursor: pointer;
+}
+
+.sw.on {
+  border-color: #fff;
+}
