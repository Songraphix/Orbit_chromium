+// ---- Focus: timer + ambient sounds (generated with WebAudio, no files) ----
+let audioCtx = null, soundNodes = null;
+function setSound(kind) {
+  if (soundNodes) { try { soundNodes.stop(); } catch {} soundNodes = null; }
+  if (!kind) return;
+  audioCtx = audioCtx || new AudioContext();
+  const len = audioCtx.sampleRate * 2;
+  const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
+  const d = buf.getChannelData(0);
+  let last = 0;
+  for (let i = 0; i < len; i++) {
+    const w = Math.random() * 2 - 1;
+    if (kind === 'brown') { last = (last + 0.02 * w) / 1.02; d[i] = last * 3.5; } else d[i] = w * 0.5;
+  }
+  const src = audioCtx.createBufferSource(); src.buffer = buf; src.loop = true;
+  const filter = audioCtx.createBiquadFilter();
+  filter.type = kind === 'rain' ? 'highpass' : 'lowpass';
+  filter.frequency.value = kind === 'rain' ? 1200 : kind === 'brown' ? 600 : 8000;
+  const gain = audioCtx.createGain(); gain.gain.value = kind === 'white' ? 0.15 : 0.35;
+  src.connect(filter); filter.connect(gain); gain.connect(audioCtx.destination); src.start();
+  soundNodes = src;
+}
+let focusTimer = null, focusSecs = null, focusMode = 'focus';
+function viewFocus(view) {
+  const MODES = { focus: 25 * 60, short: 5 * 60, long: 15 * 60 };
+  if (focusSecs === null) focusSecs = MODES[focusMode];
+  const stats = load('focusStats', { sessions: 0, minutes: 0 });
+  const clock = el('div', { style: 'font-size:84px;font-weight:600;letter-spacing:-0.02em;text-align:center;margin:24px 0 8px' });
+  const info = el('div', { class: 'sub', style: 'text-align:center' });
+  const startBtn = el('button', { class: 'btn primary' });
+  const fmt = () => { clock.textContent = `${String(Math.floor(focusSecs / 60)).padStart(2, '0')}:${String(focusSecs % 60).padStart(2, '0')}`; startBtn.textContent = focusTimer ? '■ Pause' : '▶ Start'; info.textContent = `${stats.sessions} sessions · ${stats.minutes} min focused in total`; };
+  const modeBtns = Object.entries(MODES).map(([m, secs]) => el('button', { class: 'btn' + (m === focusMode ? ' primary' : ''), onclick: () => { clearInterval(focusTimer); focusTimer = null; focusMode = m; focusSecs = secs; route(); } }, m === 'focus' ? 'Focus 25' : m === 'short' ? 'Break 5' : 'Long break 15'));
+  startBtn.addEventListener('click', () => {
+    if (focusTimer) { clearInterval(focusTimer); focusTimer = null; fmt(); return; }
+    focusTimer = setInterval(() => {
+      if (--focusSecs <= 0) {
+        clearInterval(focusTimer); focusTimer = null;
+        if (focusMode === 'focus') { stats.sessions++; stats.minutes += 25; save('focusStats', stats); }
+        focusSecs = MODES[focusMode];
+      }
+      if (document.body.contains(clock)) fmt();
+    }, 1000);
+    fmt();
+  });
+  const sounds = [['', 'Silence'], ['rain', 'Rain'], ['brown', 'Brown noise'], ['white', 'White noise']].map(([k, label]) => el('button', { class: 'btn', onclick: () => setSound(k) }, label));
+  view.append(el('h2', {}, 'Focus'), el('div', { class: 'tools', style: 'justify-content:center' }, ...modeBtns), clock, info, el('div', { class: 'tools', style: 'justify-content:center;margin-top:12px' }, startBtn, el('button', { class: 'btn', onclick: () => { clearInterval(focusTimer); focusTimer = null; focusSecs = MODES[focusMode]; fmt(); } }, 'Reset')), el('div', { class: 'sub', style: 'text-align:center;margin-top:18px' }, 'Ambient sound'), el('div', { class: 'tools', style: 'justify-content:center' }, ...sounds));
+  fmt();
+}
+
+// ---- Toolkit: small developer utilities ----
+function viewToolkit(view) {
+  const tool = (title, ...kids) => el('div', { class: 'item', style: 'cursor:default;display:flex;flex-direction:column;gap:8px' }, el('div', { class: 't' }, title), ...kids);
+  const area = (ph) => el('textarea', { class: 'field', placeholder: ph, style: 'min-height:80px;resize:vertical' });
+  const out = () => el('div', { class: 'sub', style: 'white-space:pre-wrap;word-break:break-all;user-select:text;font-family:ui-monospace,Menlo,monospace;font-size:12px' });
+  const json = area('Paste JSON'); const jo = out();
+  json.addEventListener('input', () => { try { jo.textContent = JSON.stringify(JSON.parse(json.value), null, 2); } catch (e) { jo.textContent = json.value ? 'Invalid JSON: ' + e.message : ''; } });
+  const b64 = area('Text or Base64'); const bo = out();
+  const run = (fn) => { try { bo.textContent = fn(b64.value); } catch (e) { bo.textContent = 'Error: ' + e.message; } };
+  const url = area('Text or URL-encoded'); const uo = out();
+  const ts = el('input', { class: 'field', placeholder: 'Unix timestamp (s or ms) or date' }); const to = out();
+  ts.addEventListener('input', () => { const v = ts.value.trim(); if (!v) { to.textContent = ''; return; } const n = Number(v); const d = Number.isFinite(n) ? new Date(n < 1e12 ? n * 1000 : n) : new Date(v); to.textContent = isNaN(d) ? 'Unrecognised' : `${d.toISOString()}\n${d.toLocaleString()}\nunix ${Math.floor(d.getTime() / 1000)}`; });
+  const uu = out(); const uuBtn = el('button', { class: 'btn', onclick: () => { uu.textContent = crypto.randomUUID(); } }, 'New UUID');
+  const hex = el('input', { class: 'field', placeholder: '#6fb3aa' }); const ho = out();
+  hex.addEventListener('input', () => { const m = /^#?([0-9a-f]{6})$/i.exec(hex.value.trim()); if (!m) { ho.textContent = ''; return; } const n = parseInt(m[1], 16); ho.textContent = `rgb(${n >> 16}, ${(n >> 8) & 255}, ${n & 255})`; ho.style.borderLeft = `14px solid #${m[1]}`; });
+  view.append(el('h2', {}, 'Toolkit'), el('div', { style: 'display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px' },
+    tool('JSON formatter', json, jo),
+    tool('Base64', b64, el('div', { class: 'tools' }, el('button', { class: 'btn', onclick: () => run((v) => btoa(unescape(encodeURIComponent(v)))) }, 'Encode'), el('button', { class: 'btn', onclick: () => run((v) => decodeURIComponent(escape(atob(v)))) }, 'Decode')), bo),
+    tool('URL encode', url, el('div', { class: 'tools' }, el('button', { class: 'btn', onclick: () => { uo.textContent = encodeURIComponent(url.value); } }, 'Encode'), el('button', { class: 'btn', onclick: () => { try { uo.textContent = decodeURIComponent(url.value); } catch (e) { uo.textContent = 'Error: ' + e.message; } } }, 'Decode')), uo),
+    tool('Timestamp', ts, to),
+    tool('UUID', uuBtn, uu),
+    tool('Hex to RGB', hex, ho)));
+}
