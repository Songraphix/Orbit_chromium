+// ---- Library: everything in one place ----
+function viewLibrary(view) {
+  const counts = { notes: getNotes().length, tasks: load('tasks', []).length, projects: getProjects().length, easels: load('easels', []).length };
+  const card = (title, sub, href) => el('a', { class: 'item', href, style: 'text-decoration:none;color:inherit;display:block' }, el('div', { class: 't' }, title), el('div', { class: 's' }, sub));
+  view.append(el('h2', {}, 'Library'), el('div', { class: 'sub' }, 'Your Orbit content'),
+    el('div', { style: 'display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px' },
+      card('Notes', `${counts.notes} notes`, '#notes'), card('Tasks', `${counts.tasks} tasks`, '#tasks'), card('Projects', `${counts.projects} projects`, '#projects'), card('Easels', `${counts.easels} easels`, '#easels')),
+    el('div', { class: 'sub', style: 'margin-top:12px' }, 'Browser'),
+    el('div', { style: 'display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px' },
+      card('Downloads', 'chrome://downloads', 'chrome://downloads'), card('History', 'chrome://history', 'chrome://history'), card('Bookmarks', 'chrome://bookmarks', 'chrome://bookmarks'), card('Archive', 'Closed tabs: chrome://history', 'chrome://history')));
+}
+
+// ---- Settings ----
+function viewSettings(view) {
+  const persist = () => save('settings', settings);
+  const nameI = el('input', { class: 'field', placeholder: 'Your name', value: settings.name || '' });
+  nameI.addEventListener('input', () => { settings.name = nameI.value.trim(); persist(); });
+  const select = (key, opts) => { const s = el('select', { class: 'field' }, ...opts.map(([v, l]) => el('option', { value: v }, l))); s.value = settings[key]; s.addEventListener('change', () => { settings[key] = s.value; persist(); }); return s; };
+  const row = (label, ctl) => el('div', { style: 'display:grid;grid-template-columns:180px 1fr;gap:12px;align-items:center;max-width:560px' }, el('div', { class: 'sub' }, label), ctl);
+  const hour = el('input', { type: 'checkbox' }); hour.checked = !!settings.hour24; hour.addEventListener('change', () => { settings.hour24 = hour.checked; persist(); });
+  const wp = el('div', { style: 'display:flex;gap:10px;flex-wrap:wrap' }, ...Object.entries(WALLPAPERS).map(([k, [label, v]]) => el('button', { class: 'btn' + (settings.wallpaper === k ? ' primary' : ''), onclick: () => { settings.wallpaper = k; persist(); document.documentElement.style.setProperty('--orbit-wallpaper', v ? `var(${v})` : ''); route(); } }, label)));
+  const reset = el('button', { class: 'btn', style: 'align-self:flex-start', onclick: () => { if (confirm('Delete all Orbit notes, tasks, projects, easels and settings?')) { for (const k of Object.keys(localStorage)) if (k.startsWith('orbit.')) localStorage.removeItem(k); location.reload(); } } }, 'Erase all Orbit data');
+  view.append(el('h2', {}, 'Settings'), row('Name', nameI), row('Search engine', select('engine', [['google', 'Google'], ['duckduckgo', 'DuckDuckGo'], ['bing', 'Bing'], ['brave', 'Brave Search']])), row('24-hour clock', hour), el('div', { class: 'sub', style: 'margin-top:8px' }, 'Wallpaper'), wp, el('div', { style: 'flex:1' }), reset);
+}
+
+const VIEWS = { projects: viewProjects, notes: viewNotes, tasks: viewTasks, easels: viewEasels, focus: viewFocus, toolkit: viewToolkit, library: viewLibrary, settings: viewSettings };
 
 function route() {
   const id = VIEWS[location.hash.slice(1)] ? location.hash.slice(1) : 'projects';
