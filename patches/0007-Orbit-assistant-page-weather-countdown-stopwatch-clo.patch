+// Copyright 2026 Songraphix. Orbit new tab page.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ORBIT_NTP_ORBIT_FETCH_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ORBIT_NTP_ORBIT_FETCH_HANDLER_H_
+
+#include <list>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+namespace network {
+class SimpleURLLoader;
+}
+
+// Lets Orbit's pages call a short allowlist of web APIs (the Anthropic API for
+// the assistant, Open-Meteo for weather) through the browser process. Trusted
+// chrome:// pages must not make their own network requests, so JS calls
+// chrome.send("orbitFetch", [id, url, method, headers, body]) and gets back
+// {status, body}.
+class OrbitFetchHandler : public content::WebUIMessageHandler {
+ public:
+  OrbitFetchHandler();
+  OrbitFetchHandler(const OrbitFetchHandler&) = delete;
+  OrbitFetchHandler& operator=(const OrbitFetchHandler&) = delete;
+  ~OrbitFetchHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  void HandleFetch(const base::ListValue& args);
+  void OnDone(std::list<std::unique_ptr<network::SimpleURLLoader>>::iterator it,
+              std::string callback_id,
+              std::optional<std::string> body);
+
+  std::list<std::unique_ptr<network::SimpleURLLoader>> loaders_;
+  base::WeakPtrFactory<OrbitFetchHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ORBIT_NTP_ORBIT_FETCH_HANDLER_H_
