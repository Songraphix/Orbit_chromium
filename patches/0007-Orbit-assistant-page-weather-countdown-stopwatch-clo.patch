--- /dev/null
+++ b/chrome/browser/ui/webui/orbit_ntp/orbit_fetch_handler.cc
@@ -0,0 +1,132 @@
+// Copyright 2026 Songraphix. Orbit new tab page.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/orbit_ntp/orbit_fetch_handler.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_ui.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr size_t kMaxResponseBytes =
+    network::SimpleURLLoader::kMaxBoundedStringDownloadSize;
+
+bool IsAllowedUrl(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs("https")) {
+    return false;
+  }
+  const std::string host(url.host());
+  return host == "api.anthropic.com" || host == "api.open-meteo.com" ||
+         host == "geocoding-api.open-meteo.com";
+}
+
+}  // namespace
+
+OrbitFetchHandler::OrbitFetchHandler() = default;
+OrbitFetchHandler::~OrbitFetchHandler() = default;
+
+void OrbitFetchHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "orbitFetch", base::BindRepeating(&OrbitFetchHandler::HandleFetch,
+                                        base::Unretained(this)));
+}
+
+void OrbitFetchHandler::HandleFetch(const base::ListValue& args) {
+  if (args.size() < 5 || !args[0].is_string() || !args[1].is_string() ||
+      !args[2].is_string() || !args[3].is_dict() || !args[4].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  const std::string callback_id = args[0].GetString();
+  GURL url(args[1].GetString());
+  if (!IsAllowedUrl(url)) {
+    base::DictValue result;
+    result.Set("status", 0);
+    result.Set("body", "Blocked: this address is not allowed.");
+    ResolveJavascriptCallback(base::Value(callback_id), result);
+    return;
+  }
+
+  net::NetworkTrafficAnnotationTag traffic_annotation =
+      net::DefineNetworkTrafficAnnotation("orbit_page_fetch", R"(
+        semantics {
+          sender: "Orbit pages"
+          description:
+            "Orbit's assistant page sends the user's chat messages to the "
+            "Anthropic API with the user's own API key, and the weather "
+            "widget asks Open-Meteo for the forecast of a user-chosen city."
+          trigger: "The user sends a chat message or opens the new tab page "
+                   "with the weather widget enabled."
+          data: "Chat messages, the user's API key, and a city name or "
+                "coordinates."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Do not use the Orbit assistant or weather widget."
+          policy_exception_justification: "Not implemented."
+        })");
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = args[2].GetString() == "POST" ? "POST" : "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  for (const auto [key, value] : args[3].GetDict()) {
+    if (value.is_string()) {
+      request->headers.SetHeader(key, value.GetString());
+    }
+  }
+
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 traffic_annotation);
+  const std::string& body = args[4].GetString();
+  if (!body.empty()) {
+    loader->AttachStringForUpload(body, "application/json");
+  }
+  loader->SetAllowHttpErrorResults(true);
+
+  auto* factory = Profile::FromWebUI(web_ui())
+                      ->GetDefaultStoragePartition()
+                      ->GetURLLoaderFactoryForBrowserProcess()
+                      .get();
+  loaders_.push_back(std::move(loader));
+  auto it = std::prev(loaders_.end());
+  (*it)->DownloadToString(
+      factory,
+      base::BindOnce(&OrbitFetchHandler::OnDone, weak_factory_.GetWeakPtr(), it,
+                     callback_id),
+      kMaxResponseBytes);
+}
+
+void OrbitFetchHandler::OnDone(
+    std::list<std::unique_ptr<network::SimpleURLLoader>>::iterator it,
+    std::string callback_id,
+    std::optional<std::string> body) {
+  int status = 0;
+  const network::SimpleURLLoader* loader = it->get();
+  if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+    status = loader->ResponseInfo()->headers->response_code();
+  }
+  base::DictValue result;
+  result.Set("status", status);
+  result.Set("body", body.has_value() ? *body : std::string("Network error"));
+  loaders_.erase(it);
+  ResolveJavascriptCallback(base::Value(callback_id), result);
+}
