+// Weather (Open-Meteo, no key; the city is set on the Settings page)
+WIDGETS.weather = () => {
+  const { c } = card('Weather');
+  const body = el('div', { style: 'display:flex;flex-direction:column;gap:6px' });
+  c.append(body);
+  const city = settings.city;
+  if (!city) { body.textContent = 'Set your city in Settings.'; return; }
+  body.textContent = 'Loading…';
+  const CODES = { 0: 'Clear', 1: 'Mostly clear', 2: 'Partly cloudy', 3: 'Overcast', 45: 'Fog', 48: 'Fog', 51: 'Drizzle', 53: 'Drizzle', 55: 'Drizzle', 61: 'Rain', 63: 'Rain', 65: 'Heavy rain', 71: 'Snow', 73: 'Snow', 75: 'Heavy snow', 80: 'Showers', 81: 'Showers', 82: 'Heavy showers', 95: 'Thunderstorm', 96: 'Thunderstorm', 99: 'Thunderstorm' };
+  netFetch(`https://api.open-meteo.com/v1/forecast?latitude=${city.lat}&longitude=${city.lon}&current=temperature_2m,weather_code,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min&timezone=auto`)
+    .then((r) => r.json()).then((d) => {
+      body.replaceChildren(
+        el('div', { style: 'font-size:40px;font-weight:600' }, `${Math.round(d.current.temperature_2m)}°`),
+        el('div', {}, CODES[d.current.weather_code] ?? 'Weather'),
+        el('div', { class: 'sub' }, `${city.name} · H ${Math.round(d.daily.temperature_2m_max[0])}° L ${Math.round(d.daily.temperature_2m_min[0])}° · wind ${Math.round(d.current.wind_speed_10m)} km/h`));
+    }).catch(() => { body.textContent = 'Weather unavailable.'; });
+};
+
+// Countdown
+WIDGETS.countdown = () => {
+  const { c } = card('Countdown');
+  const cd = load('countdown', { label: 'Launch day', date: '' });
+  const label = el('input', { class: 'field', value: cd.label, placeholder: 'Label' });
+  const date = el('input', { class: 'field', type: 'date', value: cd.date });
+  const out = el('div', { style: 'font-size:34px;font-weight:600' });
+  const render = () => {
+    if (!date.value) { out.textContent = 'Pick a date'; return; }
+    const days = Math.ceil((new Date(date.value + 'T00:00:00') - Date.now()) / 86400000);
+    out.textContent = days > 0 ? `${days} day${days === 1 ? '' : 's'}` : days === 0 ? 'Today!' : `${-days}d ago`;
+  };
+  const store = () => { save('countdown', { label: label.value, date: date.value }); render(); };
+  label.addEventListener('input', store); date.addEventListener('change', store);
+  c.append(out, label, date); render();
+};
+
+// Stopwatch
+WIDGETS.stopwatch = () => {
+  const { c } = card('Stopwatch');
+  let start = 0, elapsed = 0, timer = null;
+  const t = el('div', { class: 'timer' });
+  const fmt = () => { const ms = elapsed + (timer ? Date.now() - start : 0); const s = Math.floor(ms / 1000); t.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}.${String(Math.floor((ms % 1000) / 10)).padStart(2, '0')}`; };
+  const go = el('button', { class: 'btn primary' }, 'Start');
+  go.addEventListener('click', () => {
+    if (timer) { elapsed += Date.now() - start; clearInterval(timer); timer = null; go.textContent = 'Start'; }
+    else { start = Date.now(); timer = setInterval(fmt, 50); go.textContent = 'Stop'; }
+    fmt();
+  });
+  const reset = el('button', { class: 'btn', onclick: () => { clearInterval(timer); timer = null; elapsed = 0; go.textContent = 'Start'; fmt(); } }, 'Reset');
+  fmt(); c.append(t, el('div', { class: 'row' }, go, reset));
+};
+
+// World clocks
+WIDGETS.clocks = () => {
+  const { c } = card('World clocks');
+  const zones = [['New York', 'America/New_York'], ['London', 'Europe/London'], ['Lagos', 'Africa/Lagos'], ['Tokyo', 'Asia/Tokyo']];
+  const rows = zones.map(([n, z]) => { const t = el('span', { class: 'sub' }); return { z, t, row: el('div', { class: 'row' }, el('span', { class: 'grow' }, n), t) }; });
+  const upd = () => { for (const r of rows) r.t.textContent = new Date().toLocaleTimeString([], { timeZone: r.z, hour: '2-digit', minute: '2-digit', hour12: !settings.hour24 }); };
+  upd(); setInterval(upd, 15000);
+  c.append(...rows.map((r) => r.row));
+};
+
+// Ask: jump to the assistant
+WIDGETS.ask = () => {
+  const { c } = card('Ask Orbit');
+  const f = el('input', { class: 'field', placeholder: 'Ask the assistant…' });
+  f.addEventListener('keydown', (e) => { if (e.key === 'Enter' && f.value.trim()) { save('askPending', f.value.trim()); location.href = 'pages.html#assistant'; } });
+  c.append(el('div', { class: 'sub' }, settings.apiKey ? 'Your question opens the assistant.' : 'Add your API key in Settings first.'), f);
+};
+
+for (const k of settings.widgets) WIDGETS[k]?.();
+
