+// ---- Assistant (Anthropic API, key from Settings; requests go through the browser) ----
+let assistantBusy = false;
+function viewAssistant(view) {
+  const chats = load('chats', []);
+  let selected = chats[0]?.id ?? null;
+  const left = el('div', { class: 'list' });
+  const right = el('div', { class: 'editor' });
+  const persist = () => save('chats', chats);
+  const log = el('div', { style: 'flex:1;overflow:auto;display:flex;flex-direction:column;gap:10px;min-height:0' });
+  const input = el('textarea', { class: 'field', placeholder: settings.apiKey ? 'Message Orbit… (Enter to send, Shift+Enter for a new line)' : 'Add your API key in Settings to chat.', style: 'flex:none;min-height:64px;max-height:160px;resize:vertical' });
+  const bubble = (m) => el('div', { style: `align-self:${m.role === 'user' ? 'flex-end' : 'flex-start'};max-width:80%;white-space:pre-wrap;word-break:break-word;user-select:text;padding:10px 14px;border-radius:14px;background:${m.role === 'user' ? 'rgb(47 123 220 / 0.7)' : 'rgb(255 255 255 / 0.12)'};line-height:1.45;font-size:14px` }, m.content || '…');
+  const renderList = () => {
+    left.replaceChildren(el('button', { class: 'btn primary', onclick: () => newChat() }, '+ New chat'), ...chats.map((c) => el('div', { class: 'item' + (c.id === selected ? ' on' : ''), onclick: () => { selected = c.id; renderList(); renderChat(); } },
+      el('div', { class: 't grow' }, c.title || 'New chat'), el('button', { class: 'x', title: 'Delete', onclick: (e) => { e.stopPropagation(); chats.splice(chats.indexOf(c), 1); selected = chats[0]?.id ?? null; persist(); renderList(); renderChat(); } }, '×'))));
+  };
+  const renderChat = () => {
+    const c = chats.find((x) => x.id === selected);
+    log.replaceChildren(...(c ? c.messages.map(bubble) : [el('div', { class: 'sub' }, 'Ask anything. Your conversations stay in this browser; messages go to the Anthropic API with the key you set.')]));
+    log.scrollTop = log.scrollHeight;
+  };
+  function newChat() { const c = { id: uid(), title: '', messages: [] }; chats.unshift(c); selected = c.id; persist(); renderList(); renderChat(); input.focus(); return c; }
+  async function send(text) {
+    if (assistantBusy || !text.trim()) return;
+    if (!settings.apiKey) { alert('Add your Anthropic API key in Settings first.'); return; }
+    let c = chats.find((x) => x.id === selected) || newChat();
+    c.messages.push({ role: 'user', content: text.trim() });
+    if (!c.title) c.title = text.trim().slice(0, 40);
+    const reply = { role: 'assistant', content: '' };
+    c.messages.push(reply); persist(); renderList(); renderChat();
+    assistantBusy = true;
+    try {
+      const resp = await netFetch('https://api.anthropic.com/v1/messages', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json', 'x-api-key': settings.apiKey, 'anthropic-version': '2023-06-01' },
+        body: JSON.stringify({ model: settings.model || 'claude-sonnet-5-5', max_tokens: 4096, system: 'You are Orbit, a concise, helpful assistant built into the Orbit browser.', messages: c.messages.slice(0, -1).map(({ role, content }) => ({ role, content })) }),
+      });
+      const data = await resp.json().catch(() => null);
+      if (!resp.ok) reply.content = `Error ${resp.status}: ${data?.error?.message ?? (await resp.text()).slice(0, 300)}`;
+      else reply.content = (data.content || []).filter((b) => b.type === 'text').map((b) => b.text).join('') || '(empty reply)';
+    } catch (e) { reply.content = 'Request failed: ' + e.message; }
+    assistantBusy = false; persist(); if (document.body.contains(log)) renderChat();
+  }
+  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); const t = input.value; input.value = ''; send(t); } });
+  right.append(log, input);
+  view.append(el('h2', {}, 'Assistant', el('span', { class: 'sub' }, settings.model)), el('div', { class: 'split' }, left, right));
+  renderList(); renderChat();
+  const pending = load('askPending', null);
+  if (pending) { save('askPending', null); newChat(); send(pending); }
 }
 
