diff --git a/chrome/browser/ui/webui/orbit_ntp/orbit_browser_handler.cc b/chrome/browser/ui/webui/orbit_ntp/orbit_browser_handler.cc
new file mode 100644
index 0000000000..1b0a189513
--- /dev/null
+++ b/chrome/browser/ui/webui/orbit_ntp/orbit_browser_handler.cc
@@ -0,0 +1,211 @@
+// Copyright 2026 Songraphix. Orbit new tab page.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/orbit_ntp/orbit_browser_handler.h"
+
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "components/tab_groups/tab_group_color.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/tab_group.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr size_t kMaxTabsPerCall = 100;
+
+tab_groups::TabGroupColorId ColorFromName(std::string_view name) {
+  using tab_groups::TabGroupColorId;
+  if (name == "blue") return TabGroupColorId::kBlue;
+  if (name == "red") return TabGroupColorId::kRed;
+  if (name == "yellow") return TabGroupColorId::kYellow;
+  if (name == "green") return TabGroupColorId::kGreen;
+  if (name == "pink") return TabGroupColorId::kPink;
+  if (name == "purple") return TabGroupColorId::kPurple;
+  if (name == "cyan") return TabGroupColorId::kCyan;
+  if (name == "orange") return TabGroupColorId::kOrange;
+  return TabGroupColorId::kGrey;
+}
+
+// Only web addresses and Orbit's own pages may be opened from a page.
+bool IsOpenableUrl(const GURL& url) {
+  return url.is_valid() && (url.SchemeIs("https") || url.SchemeIs("http") ||
+                            url.SchemeIs("chrome"));
+}
+
+}  // namespace
+
+OrbitBrowserHandler::OrbitBrowserHandler() = default;
+OrbitBrowserHandler::~OrbitBrowserHandler() = default;
+
+void OrbitBrowserHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "orbitGetTabs", base::BindRepeating(&OrbitBrowserHandler::HandleGetTabs,
+                                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "orbitOpenTabs", base::BindRepeating(&OrbitBrowserHandler::HandleOpenTabs,
+                                           base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "orbitGroupTabs",
+      base::BindRepeating(&OrbitBrowserHandler::HandleGroupTabs,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "orbitFocusTab", base::BindRepeating(&OrbitBrowserHandler::HandleFocusTab,
+                                           base::Unretained(this)));
+}
+
+void OrbitBrowserHandler::HandleGetTabs(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  base::ListValue tabs;
+  BrowserWindowInterface* browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (browser) {
+    TabStripModel* strip = browser->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      content::WebContents* contents = strip->GetWebContentsAt(i);
+      base::DictValue tab;
+      tab.Set("index", i);
+      tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+      tab.Set("url", contents->GetVisibleURL().spec());
+      tab.Set("pinned", strip->IsTabPinned(i));
+      tab.Set("self", contents == web_ui()->GetWebContents());
+      std::string group_title;
+      if (auto group = strip->GetTabGroupForTab(i)) {
+        const auto* data =
+            strip->group_model()->GetTabGroup(*group)->visual_data();
+        group_title = base::UTF16ToUTF8(data->title());
+      }
+      tab.Set("group", group_title);
+      tabs.Append(std::move(tab));
+    }
+  }
+  ResolveJavascriptCallback(args[0], tabs);
+}
+
+void OrbitBrowserHandler::HandleOpenTabs(const base::ListValue& args) {
+  if (args.size() < 4 || !args[0].is_string() || !args[1].is_list() ||
+      !args[2].is_string() || !args[3].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  int opened = 0;
+  BrowserWindowInterface* browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (browser) {
+    TabStripModel* strip = browser->GetTabStripModel();
+    const int first_index = strip->count();
+    for (const base::Value& value : args[1].GetList()) {
+      if (opened >= static_cast<int>(kMaxTabsPerCall) || !value.is_string()) {
+        break;
+      }
+      GURL url(value.GetString());
+      if (!IsOpenableUrl(url)) {
+        continue;
+      }
+      chrome::AddTabAt(browser, url, -1, /*foreground=*/opened == 0);
+      ++opened;
+    }
+    const std::string& title = args[2].GetString();
+    if (opened > 0 && !title.empty()) {
+      std::vector<int> indices;
+      for (int i = first_index; i < first_index + opened; ++i) {
+        indices.push_back(i);
+      }
+      tab_groups::TabGroupId group = strip->AddToNewGroup(indices);
+      strip->group_model()->GetTabGroup(group)->SetVisualData(
+          tab_groups::TabGroupVisualData(base::UTF8ToUTF16(title),
+                                         ColorFromName(args[3].GetString())),
+          /*is_customized=*/true);
+    }
+  }
+  ResolveJavascriptCallback(args[0], base::Value(opened));
+}
+
+void OrbitBrowserHandler::HandleGroupTabs(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_string() || !args[1].is_list()) {
+    return;
+  }
+  AllowJavascript();
+  int made = 0;
+  BrowserWindowInterface* browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (browser) {
+    TabStripModel* strip = browser->GetTabStripModel();
+    // Grouping moves tabs, so remember each tab by its contents, not index.
+    std::vector<content::WebContents*> by_index;
+    for (int i = 0; i < strip->count(); ++i) {
+      by_index.push_back(strip->GetWebContentsAt(i));
+    }
+    for (const base::Value& entry : args[1].GetList()) {
+      if (!entry.is_dict()) {
+        continue;
+      }
+      const base::DictValue& dict = entry.GetDict();
+      const std::string* title = dict.FindString("title");
+      const std::string* color = dict.FindString("color");
+      const base::ListValue* wanted = dict.FindList("tabs");
+      if (!title || !wanted) {
+        continue;
+      }
+      std::vector<content::WebContents*> members;
+      for (const base::Value& idx : *wanted) {
+        if (idx.is_int() && idx.GetInt() >= 0 &&
+            idx.GetInt() < static_cast<int>(by_index.size())) {
+          members.push_back(by_index[idx.GetInt()]);
+        }
+      }
+      std::vector<int> indices;
+      for (content::WebContents* contents : members) {
+        int now = strip->GetIndexOfWebContents(contents);
+        if (now >= 0 && !strip->IsTabPinned(now) &&
+            contents != web_ui()->GetWebContents()) {
+          indices.push_back(now);
+        }
+      }
+      if (indices.empty()) {
+        continue;
+      }
+      tab_groups::TabGroupId group = strip->AddToNewGroup(indices);
+      strip->group_model()->GetTabGroup(group)->SetVisualData(
+          tab_groups::TabGroupVisualData(
+              base::UTF8ToUTF16(*title),
+              ColorFromName(color ? *color : std::string())),
+          /*is_customized=*/true);
+      ++made;
+    }
+  }
+  ResolveJavascriptCallback(args[0], base::Value(made));
+}
+
+void OrbitBrowserHandler::HandleFocusTab(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_int()) {
+    return;
+  }
+  BrowserWindowInterface* browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (!browser) {
+    return;
+  }
+  TabStripModel* strip = browser->GetTabStripModel();
+  int index = args[0].GetInt();
+  if (index >= 0 && index < strip->count()) {
+    strip->ActivateTabAt(index);
+  }
+}
