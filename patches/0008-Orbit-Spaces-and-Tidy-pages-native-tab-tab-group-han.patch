+    const swatches = el('div', { class: 'tools' }, ...SPACE_COLORS.map((c) => el('span', { class: 'sw' + (c === sp.color ? ' on' : ''), style: `background:${SPACE_HEX[c]}`, onclick: () => { sp.color = c; persist(); renderList(); renderEditor(); } })));
+    const addU = el('input', { class: 'field', placeholder: 'Add a site (example.com) and press Enter' });
+    addU.addEventListener('keydown', (e) => { if (e.key === 'Enter' && addU.value.trim()) { let u = addU.value.trim(); if (!/^[a-z]+:\/\//i.test(u)) u = 'https://' + u; sp.urls.push(u); persist(); renderList(); renderEditor(); } });
+    const saveCur = el('button', { class: 'btn', onclick: async () => { const tabs = await browserCall('orbitGetTabs'); for (const t of tabs) if (!t.self && /^https?:/.test(t.url) && !sp.urls.includes(t.url)) sp.urls.push(t.url); persist(); renderList(); renderEditor(); } }, 'Add all open tabs');
+    const open = el('button', { class: 'btn primary', onclick: () => browserCall('orbitOpenTabs', sp.urls, sp.name, sp.color) }, '▶ Open space');
+    right.replaceChildren(name, swatches, el('div', { class: 'tools' }, open, saveCur), ...sp.urls.map((u, i) => el('div', { class: 'row' }, el('span', { class: 'grow' }, u), el('button', { class: 'x', title: 'Remove', onclick: () => { sp.urls.splice(i, 1); persist(); renderList(); renderEditor(); } }, '×'))), addU,
+      el('button', { class: 'btn', style: 'align-self:flex-start;margin-top:12px', onclick: () => { spaces.splice(spaces.indexOf(sp), 1); selected = spaces[0]?.id ?? null; persist(); renderList(); renderEditor(); } }, 'Delete space'));
