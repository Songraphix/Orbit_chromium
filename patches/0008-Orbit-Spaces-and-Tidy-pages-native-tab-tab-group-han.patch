+}
+
+// ---- Tidy: the assistant groups your open tabs by topic ----
+function viewTidy(view) {
+  const out = el('div', { class: 'sub', style: 'white-space:pre-wrap' });
+  const list = el('div', { style: 'display:flex;flex-direction:column;gap:6px' });
+  const run = el('button', { class: 'btn primary', style: 'align-self:flex-start' }, '✦ Tidy my tabs');
+  const load_ = async () => {
+    const tabs = (await browserCall('orbitGetTabs')).filter((t) => !t.self && !t.pinned && !t.group);
+    list.replaceChildren(...tabs.map((t) => el('div', { class: 'row' }, el('span', { class: 'grow' }, t.title || t.url), el('span', { class: 'sub' }, (() => { try { return new URL(t.url).hostname; } catch { return ''; } })()))));
+    out.textContent = tabs.length ? `${tabs.length} ungrouped tab${tabs.length === 1 ? '' : 's'}.` : 'No ungrouped tabs to tidy.';
+    return tabs;
+  };
+  run.addEventListener('click', async () => {
+    if (!settings.apiKey) { out.textContent = 'Add your Anthropic API key in Settings first.'; return; }
+    const tabs = await load_();
+    if (tabs.length < 2) return;
+    run.disabled = true; out.textContent = 'Thinking…';
+    try {
+      const prompt = 'Group these browser tabs into a few topical groups (2-6 groups, 2+ tabs each; leave unrelated tabs out). Reply with ONLY JSON: [{"title":"short name","color":"blue|green|purple|orange|pink|cyan|red|yellow","tabs":[index,...]}]. Tabs:\n' + tabs.map((t) => `${t.index}: ${t.title} (${t.url})`).join('\n');
+      const resp = await netFetch('https://api.anthropic.com/v1/messages', { method: 'POST', headers: { 'content-type': 'application/json', 'x-api-key': settings.apiKey, 'anthropic-version': '2023-06-01' }, body: JSON.stringify({ model: settings.model || 'claude-sonnet-5-5', max_tokens: 1500, messages: [{ role: 'user', content: prompt }] }) });
+      const data = await resp.json();
+      if (!resp.ok) throw new Error(data?.error?.message || `HTTP ${resp.status}`);
+      const text = (data.content || []).map((b) => b.text || '').join('');
+      const groups = JSON.parse(text.slice(text.indexOf('['), text.lastIndexOf(']') + 1));
+      const made = await browserCall('orbitGroupTabs', groups.map((g) => ({ title: String(g.title).slice(0, 40), color: g.color, tabs: (g.tabs || []).filter(Number.isInteger) })));
+      out.textContent = `Created ${made} group${made === 1 ? '' : 's'}.`; await load_();
+    } catch (e) { out.textContent = 'Tidy failed: ' + e.message; }
+    run.disabled = false;
+  });
+  view.append(el('h2', {}, 'Tidy'), el('div', { class: 'sub' }, 'Asks the assistant to sort the ungrouped tabs in this window into tab groups. Pinned tabs are left alone.'), run, out, list);
+  load_();
+}
+
