+#ifndef CHROME_BROWSER_UI_WEBUI_ORBIT_NTP_ORBIT_BROWSER_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ORBIT_NTP_ORBIT_BROWSER_HANDLER_H_
+
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+// Gives Orbit's pages (Spaces, Tidy) controlled access to the window they are
+// open in: list its tabs, open a set of URLs as a tab group, and group
+// existing tabs.
+class OrbitBrowserHandler : public content::WebUIMessageHandler {
+ public:
+  OrbitBrowserHandler();
+  OrbitBrowserHandler(const OrbitBrowserHandler&) = delete;
+  OrbitBrowserHandler& operator=(const OrbitBrowserHandler&) = delete;
+  ~OrbitBrowserHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  // [callbackId] -> [{index, title, url, pinned, group, self}]
+  void HandleGetTabs(const base::ListValue& args);
+  // [callbackId, urls[], groupTitle, color] -> number of tabs opened
+  void HandleOpenTabs(const base::ListValue& args);
+  // [callbackId, [{title, color, tabs: [index...]}]] -> number of groups made
+  void HandleGroupTabs(const base::ListValue& args);
+  // [index] -> activates the tab
+  void HandleFocusTab(const base::ListValue& args);
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ORBIT_NTP_ORBIT_BROWSER_HANDLER_H_
