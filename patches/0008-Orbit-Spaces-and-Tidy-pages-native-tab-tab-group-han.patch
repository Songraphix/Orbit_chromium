+// ---- Spaces: saved sets of tabs that open as a coloured tab group ----
+const SPACE_COLORS = ['blue', 'green', 'purple', 'orange', 'pink', 'cyan', 'red', 'yellow', 'grey'];
+const SPACE_HEX = { blue: '#4285f4', green: '#34a853', purple: '#8b5cf6', orange: '#fb923c', pink: '#ec4899', cyan: '#22d3ee', red: '#ef4444', yellow: '#facc15', grey: '#9ca3af' };
+function viewSpaces(view) {
+  const spaces = load('spaces', []);
+  let selected = spaces[0]?.id ?? null;
+  const left = el('div', { class: 'list' });
+  const right = el('div', { class: 'editor' });
+  const persist = () => save('spaces', spaces);
+  const renderList = () => {
+    const add = el('input', { class: 'field', placeholder: 'New space…' });
