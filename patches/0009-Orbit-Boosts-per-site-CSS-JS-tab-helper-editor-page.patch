+
+void OrbitBrowserHandler::HandleGetBoosts(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  Profile* profile = Profile::FromWebUI(web_ui());
+  ResolveJavascriptCallback(
+      args[0], profile->GetPrefs()->GetDict(orbit::kBoostsPref).Clone());
+}
+
+void OrbitBrowserHandler::HandleSetBoost(const base::ListValue& args) {
+  if (args.size() < 3 || !args[0].is_string() || !args[1].is_string() ||
+      !args[2].is_dict()) {
+    return;
+  }
+  AllowJavascript();
+  const std::string& host = args[1].GetString();
+  // Hosts only: no scheme, path or spaces.
+  if (host.empty() || host.size() > 253 ||
+      host.find_first_of("/: \t") != std::string::npos) {
+    ResolveJavascriptCallback(args[0], base::Value(false));
+    return;
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  ScopedDictPrefUpdate update(profile->GetPrefs(), orbit::kBoostsPref);
+  if (args[2].GetDict().empty()) {
+    update->Remove(host);
+  } else {
+    update->Set(host, args[2].GetDict().Clone());
+  }
+  ResolveJavascriptCallback(args[0], base::Value(true));
+}
