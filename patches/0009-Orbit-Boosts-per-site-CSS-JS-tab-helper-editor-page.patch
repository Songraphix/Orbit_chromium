+// ---- Boosts: per-site CSS and JS, applied by the browser when the site loads ----
+const BOOST_FONTS = [['', 'Site default'], ['system-ui', 'System'], ['Georgia, serif', 'Serif'], ['ui-monospace, Menlo, monospace', 'Monospace'], ['Comfortaa, system-ui', 'Comfortaa']];
+function buildBoostCss(b) {
+  let css = '';
+  const zap = (b.zap || '').split('\n').map((x) => x.trim()).filter(Boolean);
+  if (zap.length) css += `${zap.join(',\n')} { display: none !important; }\n`;
+  if (b.font) css += `html, body, body * { font-family: ${b.font} !important; }\n`;
+  if (b.dark) css += 'html { filter: invert(1) hue-rotate(180deg) !important; background: #fff; }\nimg, video, picture, canvas, svg image { filter: invert(1) hue-rotate(180deg) !important; }\n';
+  if (b.customCss) css += b.customCss + '\n';
+  return css;
+}
+async function viewBoosts(view) {
+  const boosts = (await browserCall('orbitGetBoosts')) || {};
+  const tabs = await browserCall('orbitGetTabs');
+  const openHosts = [...new Set(tabs.filter((t) => /^https?:/.test(t.url)).map((t) => { try { return new URL(t.url).hostname.replace(/^www\./, ''); } catch { return ''; } }).filter(Boolean))];
+  let selected = Object.keys(boosts)[0] ?? null;
+  const left = el('div', { class: 'list' });
+  const right = el('div', { class: 'editor' });
+  const save_ = (host) => browserCall('orbitSetBoost', host, boosts[host] ?? {});
+  const renderList = () => {
+    const add = el('input', { class: 'field', placeholder: 'Boost a site (example.com)…' });
+    const create = (h) => { h = h.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '').replace(/^www\./, ''); if (!h || boosts[h]) { selected = h || selected; renderList(); renderEditor(); return; } boosts[h] = { enabled: true, css: '', js: '' }; selected = h; save_(h); renderList(); renderEditor(); };
+    add.addEventListener('keydown', (e) => { if (e.key === 'Enter') create(add.value); });
+    left.replaceChildren(add, ...(openHosts.length ? [el('div', { class: 'sub' }, 'Open in this window')] : []), ...openHosts.map((h) => el('button', { class: 'btn', onclick: () => create(h) }, '+ ' + h)),
+      el('div', { class: 'sub', style: 'margin-top:8px' }, 'Your boosts'), ...Object.keys(boosts).map((h) => el('div', { class: 'item' + (h === selected ? ' on' : ''), onclick: () => { selected = h; renderList(); renderEditor(); } },
+        el('div', { class: 'row' }, el('span', { class: 't grow' }, h), el('span', { class: 'sub' }, boosts[h].enabled === false ? 'off' : 'on')))));
+  };
+  const renderEditor = () => {
+    const h = selected; const b = boosts[h];
+    if (!b) { right.replaceChildren(el('div', { class: 'sub' }, 'A Boost changes how one site looks or behaves: hide elements, change the font, force dark mode, or add your own CSS and JavaScript. It applies whenever you open that site.')); return; }
+    const commit = () => { b.css = buildBoostCss(b); save_(h); renderList(); };
+    const on = el('input', { type: 'checkbox' }); on.checked = b.enabled !== false; on.addEventListener('change', () => { b.enabled = on.checked; commit(); });
+    const zap = el('textarea', { class: 'field', placeholder: 'Hide elements: one CSS selector per line (e.g. .cookie-banner)', style: 'min-height:70px' }); zap.value = b.zap || ''; zap.addEventListener('input', () => { b.zap = zap.value; commit(); });
+    const font = el('select', { class: 'field' }, ...BOOST_FONTS.map(([v, l]) => el('option', { value: v }, l))); font.value = b.font || ''; font.addEventListener('change', () => { b.font = font.value; commit(); });
+    const dark = el('input', { type: 'checkbox' }); dark.checked = !!b.dark; dark.addEventListener('change', () => { b.dark = dark.checked; commit(); });
+    const css = el('textarea', { class: 'field', placeholder: 'Custom CSS', style: 'min-height:90px;font-family:ui-monospace,Menlo,monospace;font-size:12px' }); css.value = b.customCss || ''; css.addEventListener('input', () => { b.customCss = css.value; commit(); });
+    const js = el('textarea', { class: 'field', placeholder: 'Custom JavaScript (runs after the page loads, like an extension script)', style: 'min-height:90px;font-family:ui-monospace,Menlo,monospace;font-size:12px' }); js.value = b.js || ''; js.addEventListener('input', () => { b.js = js.value; commit(); });
+    right.replaceChildren(el('h2', {}, h), el('label', { class: 'row' }, on, 'Enabled'), el('div', { class: 'sub' }, 'Hide elements'), zap, el('div', { class: 'row' }, el('span', { class: 'sub' }, 'Font'), font), el('label', { class: 'row' }, dark, 'Dark mode (inverts colours)'), el('div', { class: 'sub' }, 'Custom CSS'), css, el('div', { class: 'sub' }, 'Custom JavaScript'), js,
+      el('div', { class: 'sub' }, 'Reload the site to see changes.'), el('button', { class: 'btn', style: 'align-self:flex-start', onclick: () => { delete boosts[h]; browserCall('orbitSetBoost', h, {}); selected = Object.keys(boosts)[0] ?? null; renderList(); renderEditor(); } }, 'Delete boost'));
+  };
+  view.append(el('h2', {}, 'Boosts'), el('div', { class: 'split' }, left, right));
+  renderList(); renderEditor();
+}
+
+const VIEWS = { projects: viewProjects, notes: viewNotes, tasks: viewTasks, easels: viewEasels, focus: viewFocus, toolkit: viewToolkit, library: viewLibrary, settings: viewSettings, assistant: viewAssistant, spaces: viewSpaces, tidy: viewTidy, boosts: viewBoosts };
 
 function route() {
   const id = VIEWS[location.hash.slice(1)] ? location.hash.slice(1) : 'projects';
