+// Copyright 2026 Songraphix. Orbit Boosts.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ORBIT_ORBIT_BOOSTS_TAB_HELPER_H_
+#define CHROME_BROWSER_UI_ORBIT_ORBIT_BOOSTS_TAB_HELPER_H_
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace orbit {
+
+// Profile pref (dictionary): host -> { css: string, js: string, enabled: bool,
+// ...editor fields }. Edited on Orbit's Boosts page.
+inline constexpr char kBoostsPref[] = "orbit.boosts";
+
+// Orbit Boosts: when a page for a boosted site finishes parsing, injects the
+// site's saved CSS (as a constructable stylesheet, so page CSP does not block
+// it) and JS (in an isolated world, like an extension content script).
+class BoostsTabHelper : public content::WebContentsObserver,
+                        public content::WebContentsUserData<BoostsTabHelper> {
+ public:
+  BoostsTabHelper(const BoostsTabHelper&) = delete;
+  BoostsTabHelper& operator=(const BoostsTabHelper&) = delete;
+  ~BoostsTabHelper() override;
+
+  // content::WebContentsObserver:
+  void DOMContentLoaded(content::RenderFrameHost* render_frame_host) override;
+
+ private:
+  friend class content::WebContentsUserData<BoostsTabHelper>;
+  explicit BoostsTabHelper(content::WebContents* web_contents);
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace orbit
+
+#endif  // CHROME_BROWSER_UI_ORBIT_ORBIT_BOOSTS_TAB_HELPER_H_
