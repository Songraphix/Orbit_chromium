+// Copyright 2026 Songraphix. Orbit Boosts.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/orbit/orbit_boosts_tab_helper.h"
+
+#include <string>
+
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/isolated_world_ids.h"
+#include "url/gurl.h"
+
+namespace orbit {
+
+namespace {
+
+// An isolated world of our own, next to Chrome's internal ones.
+constexpr int32_t kBoostsWorldId = content::ISOLATED_WORLD_ID_CONTENT_END + 5;
+
+std::string JsonString(const std::string& value) {
+  return base::WriteJson(base::Value(value)).value_or("\"\"");
+}
+
+}  // namespace
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BoostsTabHelper);
+
+BoostsTabHelper::BoostsTabHelper(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<BoostsTabHelper>(*web_contents) {}
+
+BoostsTabHelper::~BoostsTabHelper() = default;
+
+void BoostsTabHelper::DOMContentLoaded(
+    content::RenderFrameHost* render_frame_host) {
+  if (!render_frame_host->IsInPrimaryMainFrame()) {
+    return;
+  }
+  const GURL& url = render_frame_host->GetLastCommittedURL();
+  if (!url.SchemeIs("http") && !url.SchemeIs("https")) {
+    return;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  const base::DictValue& boosts = profile->GetPrefs()->GetDict(kBoostsPref);
+  if (boosts.empty()) {
+    return;
+  }
+
+  std::string host(url.host());
+  const base::DictValue* boost = boosts.FindDict(host);
+  if (!boost && base::StartsWith(host, "www.")) {
+    boost = boosts.FindDict(host.substr(4));
+  }
+  if (!boost && !base::StartsWith(host, "www.")) {
+    boost = boosts.FindDict("www." + host);
+  }
+  if (!boost || !boost->FindBool("enabled").value_or(true)) {
+    return;
+  }
+
+  std::string script;
+  if (const std::string* css = boost->FindString("css"); css && !css->empty()) {
+    script += "try{const s=new CSSStyleSheet();s.replaceSync(" +
+              JsonString(*css) +
+              ");document.adoptedStyleSheets=[...document.adoptedStyleSheets,"
+              "s];}catch(e){console.error('Orbit boost CSS:',e);}\n";
+  }
+  if (const std::string* js = boost->FindString("js"); js && !js->empty()) {
+    // Run the user's code through Function so a syntax error is contained.
+    script += "try{new Function(" + JsonString(*js) +
+              ")();}catch(e){console.error('Orbit boost JS:',e);}\n";
+  }
+  if (script.empty()) {
+    return;
+  }
+  render_frame_host->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script), base::NullCallback(), kBoostsWorldId);
+}
+
+}  // namespace orbit
