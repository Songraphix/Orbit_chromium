+
+void OrbitBrowserHandler::HandleClosedTabs(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  base::ListValue result;
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+  if (service) {
+    for (const auto& entry : service->entries()) {
+      if (entry->type != sessions::tab_restore::Type::TAB) {
+        continue;
+      }
+      const auto* tab =
+          static_cast<const sessions::tab_restore::Tab*>(entry.get());
+      if (tab->navigations.empty()) {
+        continue;
+      }
+      const auto& nav = tab->navigations[tab->normalized_navigation_index()];
+      base::DictValue item;
+      item.Set("title", base::UTF16ToUTF8(nav.title()));
+      item.Set("url", nav.virtual_url().spec());
+      item.Set("closedMs", static_cast<double>(
+                           entry->timestamp.InMillisecondsSinceUnixEpoch()));
+      result.Append(std::move(item));
+    }
+  }
+  ResolveJavascriptCallback(args[0], result);
+}
