+// ---- Command palette: type in the search box to jump to Orbit pages, open tabs, Spaces ----
+{
+  const box = $('search');
+  const panel = el('div', { class: 'glass', style: 'position:absolute;left:0;right:0;top:64px;border-radius:18px;padding:6px;display:none;flex-direction:column;gap:2px;z-index:10;text-align:left' });
+  box.style.position = 'relative';
+  box.append(panel);
+  const PAGES = [['Projects', 'projects'], ['Notes', 'notes'], ['Tasks', 'tasks'], ['Easels', 'easels'], ['Focus', 'focus'], ['Toolkit', 'toolkit'], ['Library', 'library'], ['Settings', 'settings'], ['Assistant', 'assistant'], ['Spaces', 'spaces'], ['Boosts', 'boosts'], ['Archive', 'archive'], ['Clipboard', 'clipboard'], ['Tidy', 'tidy']];
+  let tabs = [];
+  sendWithPromise('orbitGetTabs').then((t) => { tabs = t; }).catch(() => {});
+  const row_ = (label, sub, action) => el('div', { class: 'row', style: 'padding:9px 12px;border-radius:12px;cursor:pointer', onmousedown: (e) => { e.preventDefault(); action(); } }, el('span', { class: 'grow' }, label), el('span', { class: 'sub' }, sub));
+  const update = () => {
+    const q = $('q').value.trim().toLowerCase();
+    if (!q || q.startsWith('?')) { panel.style.display = 'none'; return; }
+    const hits = [];
+    for (const [name, id] of PAGES) if (name.toLowerCase().includes(q)) hits.push(row_(name, 'Orbit', () => { location.href = 'pages.html#' + id; }));
+    for (const t of tabs) if (!t.self && (t.title + ' ' + t.url).toLowerCase().includes(q)) hits.push(row_(t.title || t.url, 'Switch to tab', () => sendWithPromise('orbitFocusTab', t.index)));
+    for (const sp of load('spaces', [])) if (sp.name.toLowerCase().includes(q)) hits.push(row_(sp.name, 'Open space', () => sendWithPromise('orbitOpenTabs', sp.urls, sp.name, sp.color)));
+    const shown = hits.slice(0, 7);
+    shown.push(row_(`Search the web for "${$('q').value.trim()}"`, 'Enter', () => go($('q').value)));
+    panel.replaceChildren(...shown);
+    panel.style.display = 'flex';
+  };
+  $('q').addEventListener('input', update);
+  $('q').addEventListener('blur', () => { panel.style.display = 'none'; });
+  $('q').addEventListener('focus', () => sendWithPromise('orbitGetTabs').then((t) => { tabs = t; }).catch(() => {}));
+}
