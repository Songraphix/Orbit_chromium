+// ---- Archive: recently closed tabs (browser keeps the last ~25) with search ----
+async function viewArchive(view) {
+  const closed = (await browserCall('orbitClosedTabs')) || [];
+  const q = el('input', { class: 'field', placeholder: 'Search closed tabs' });
+  const list = el('div', { style: 'display:flex;flex-direction:column;gap:8px' });
+  const render = () => {
+    const needle = q.value.toLowerCase();
+    const shown = closed.filter((t) => (t.title + ' ' + t.url).toLowerCase().includes(needle));
+    list.replaceChildren(...(shown.length ? shown.map((t) => el('div', { class: 'item row', onclick: () => browserCall('orbitOpenTabs', [t.url], '', 'grey') },
+      el('div', { class: 'grow' }, el('div', { class: 't' }, t.title || t.url), el('div', { class: 's' }, t.url)), el('span', { class: 'sub' }, t.closedMs ? new Date(t.closedMs).toLocaleString() : ''))) : [el('div', { class: 'sub' }, closed.length ? 'No matches.' : 'No recently closed tabs. Older pages are in History.')]));
+  };
+  q.addEventListener('input', render);
+  view.append(el('h2', {}, 'Archive', el('span', { class: 'sub' }, 'click a tab to reopen it')), q, list, el('a', { href: 'chrome://history', class: 'sub' }, 'Open full history'));
+  render();
+}
+
+// ---- Clipboard history: captured whenever you come back to Orbit ----
+function viewClipboard(view) {
+  const items = load('clipboard', []);
+  const list = el('div', { style: 'display:flex;flex-direction:column;gap:8px' });
+  const status = el('div', { class: 'sub' }, 'Copy something anywhere, then return to this tab or press "Capture now". History stays on this device.');
+  const persist = () => save('clipboard', items);
+  const render = () => {
+    list.replaceChildren(...(items.length ? items.map((it, i) => el('div', { class: 'item row', style: 'cursor:default' },
+      el('div', { class: 'grow', style: 'white-space:pre-wrap;word-break:break-word;user-select:text;max-height:80px;overflow:hidden' }, it.text),
+      el('button', { class: 'btn', onclick: () => navigator.clipboard.writeText(it.text) }, 'Copy'),
+      el('button', { class: 'x', title: 'Delete', onclick: () => { items.splice(i, 1); persist(); render(); } }, '×'))) : [el('div', { class: 'sub' }, 'Nothing captured yet.')]));
+  };
+  const capture = async () => {
+    try {
+      const text = await navigator.clipboard.readText();
+      if (text && text.trim() && items[0]?.text !== text) { items.unshift({ text: text.slice(0, 5000), at: Date.now() }); items.length = Math.min(items.length, 100); persist(); render(); status.textContent = 'Captured.'; }
+    } catch (e) { status.textContent = 'Clipboard not available: ' + e.message; }
+  };
+  window.addEventListener('focus', capture);
+  document.addEventListener('visibilitychange', () => { if (!document.hidden) capture(); });
+  view.append(el('h2', {}, 'Clipboard'), el('div', { class: 'tools' }, el('button', { class: 'btn primary', onclick: capture }, 'Capture now'), el('button', { class: 'btn', onclick: () => { items.length = 0; persist(); render(); } }, 'Clear all')), status, list);
+  render(); capture();
+}
+
+const VIEWS = { projects: viewProjects, notes: viewNotes, tasks: viewTasks, easels: viewEasels, focus: viewFocus, toolkit: viewToolkit, library: viewLibrary, settings: viewSettings, assistant: viewAssistant, spaces: viewSpaces, tidy: viewTidy, boosts: viewBoosts, archive: viewArchive, clipboard: viewClipboard };
 
