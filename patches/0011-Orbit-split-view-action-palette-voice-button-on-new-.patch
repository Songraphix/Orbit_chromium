                           base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "orbitSplit", base::BindRepeating(&OrbitBrowserHandler::HandleSplit,
+                                        base::Unretained(this)));
   web_ui()->RegisterMessageCallback(
       "orbitClosedTabs",
       base::BindRepeating(&OrbitBrowserHandler::HandleClosedTabs,
@@ -293,3 +300,37 @@ void OrbitBrowserHandler::HandleClosedTabs(const base::ListValue& args) {
   }
   ResolveJavascriptCallback(args[0], result);
 }
+
+void OrbitBrowserHandler::HandleSplit(const base::ListValue& args) {
+  if (args.size() < 3 || !args[0].is_string() || !args[1].is_int() ||
+      !args[2].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  bool ok = false;
+  BrowserWindowInterface* browser =
+      webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  if (browser) {
+    TabStripModel* strip = browser->GetTabStripModel();
+    int index = args[1].GetInt();
+    if (index >= 0 && index < strip->count()) {
+      // Make that tab the active one; the browser's split view then pairs it
+      // with a new tab beside (or above) it.
+      strip->ActivateTabAt(index);
+      // Chromium CHECK-fails when a split tab is split again, and pinned tabs
+      // cannot be split, so only split a plain, un-split tab.
+      tabs::TabInterface* active = browser->GetActiveTabInterface();
+      if (!active || active->IsSplit() || strip->IsTabPinned(index)) {
+        ResolveJavascriptCallback(args[0], base::Value(false));
+        return;
+      }
+      chrome::NewSplitTab(browser,
+                          args[2].GetString() == "stacked"
+                              ? split_tabs::SplitTabLayout::kStacked
+                              : split_tabs::SplitTabLayout::kSideBySide,
+                          split_tabs::SplitTabCreatedSource::kToolbarButton);
+      ok = true;
+    }
+  }
+  ResolveJavascriptCallback(args[0], base::Value(ok));
+}
