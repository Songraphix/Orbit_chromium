Subject: [PATCH 11/11] Orbit: split view action (palette), voice button on new
 tab search

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../browser/resources/orbit_ntp/orbit_ntp.ts  | 18 +++++++-
 chrome/browser/ui/webui/orbit_ntp/BUILD.gn    |  2 +
 .../webui/orbit_ntp/orbit_browser_handler.cc  | 41 +++++++++++++++++++
 .../webui/orbit_ntp/orbit_browser_handler.h   |  2 +
 4 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/resources/orbit_ntp/orbit_ntp.ts b/chrome/browser/resources/orbit_ntp/orbit_ntp.ts
index 9acf999fd2..ddf9eb6812 100644
--- a/chrome/browser/resources/orbit_ntp/orbit_ntp.ts
+++ b/chrome/browser/resources/orbit_ntp/orbit_ntp.ts
@@ -79,6 +79,22 @@ $('search').addEventListener('submit', (e) => {
 });
 
 
+// ---- Voice input: the mic button uses the browser's speech recognition ----
+{
+  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
+  const mic = el('button', { type: 'button', class: 'x', title: SR ? 'Speak' : 'Speech recognition is not available', style: 'font-size:18px' }, '🎙');
+  $('search').append(mic);
+  mic.addEventListener('click', () => {
+    if (!SR) { $('q').placeholder = 'Speech recognition is not available in this build.'; return; }
+    const r = new SR(); r.lang = navigator.language || 'en-US'; r.interimResults = true;
+    mic.style.color = '#ef4444';
+    r.onresult = (e) => { $('q').value = [...e.results].map((x) => x[0].transcript).join(''); };
+    r.onerror = (e) => { $('q').placeholder = 'Voice failed: ' + e.error; mic.style.color = ''; };
+    r.onend = () => { mic.style.color = ''; if ($('q').value.trim()) $('search').requestSubmit(); };
+    try { r.start(); } catch (e) { mic.style.color = ''; }
+  });
+}
+
 // ---- Command palette: type in the search box to jump to Orbit pages, open tabs, Spaces ----
 {
   const box = $('search');
@@ -94,7 +110,7 @@ $('search').addEventListener('submit', (e) => {
     if (!q || q.startsWith('?')) { panel.style.display = 'none'; return; }
     const hits = [];
     for (const [name, id] of PAGES) if (name.toLowerCase().includes(q)) hits.push(row_(name, 'Orbit', () => { location.href = 'pages.html#' + id; }));
-    for (const t of tabs) if (!t.self && (t.title + ' ' + t.url).toLowerCase().includes(q)) hits.push(row_(t.title || t.url, 'Switch to tab', () => sendWithPromise('orbitFocusTab', t.index)));
+    for (const t of tabs) if (!t.self && (t.title + ' ' + t.url).toLowerCase().includes(q)) { hits.push(row_(t.title || t.url, 'Switch to tab', () => sendWithPromise('orbitFocusTab', t.index))); hits.push(row_('Split view: ' + (t.title || t.url), 'Side by side', () => sendWithPromise('orbitSplit', t.index, 'side'))); }
     for (const sp of load('spaces', [])) if (sp.name.toLowerCase().includes(q)) hits.push(row_(sp.name, 'Open space', () => sendWithPromise('orbitOpenTabs', sp.urls, sp.name, sp.color)));
     const shown = hits.slice(0, 7);
     shown.push(row_(`Search the web for "${$('q').value.trim()}"`, 'Enter', () => go($('q').value)));
